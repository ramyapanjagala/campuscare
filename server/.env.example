# ===== CampusCare backend environment =====
# Copy to server/.env and fill in values.

# MongoDB Atlas connection string (get from atlas.mongodb.com)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/campuscare?retryWrites=true&w=majority

# JWT secret — use a long random string in production
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_long_random_secret

# Server port (Render sets this automatically)
PORT=5000

# Admin registration secret key
ADMIN_SECRET=replace_with_your_admin_secret

# Your Vercel frontend URL (set after deploying frontend)
FRONTEND_URL=https://your-app.vercel.app
