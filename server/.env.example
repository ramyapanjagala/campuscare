# ===== CampusCare backend environment =====
# Copy this file to "server/.env" and fill in real values.
# Never commit the real .env file (it is gitignored).

# MongoDB connection string. Use a local DB for development or
# MongoDB Atlas for production.
MONGO_URI=mongodb://127.0.0.1:27017/campuscare

# JWT secret — use a long, random string in production.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_secret_string

# Server port (defaults to 5000)
PORT=5000
